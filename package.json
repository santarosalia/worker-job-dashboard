  "version": "1.0.0",
  "type": "module",
  "description": "CPU job runner with a fixed Piscina pool and a realtime dashboard",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
